# GEMINI_API_KEY: Required for Google AI Studio Developer API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for live educational video recommendations in Explore Further.
YOUTUBE_API_KEY=""

# GOOGLE_GENAI_USE_VERTEXAI: Optional ("auto" | "true" | "false").
# Uses Application Default Credentials (ADC) via the Cloud Run attached service account or Workload Identity Federation.
# No downloadable service account JSON key files are used (compliant with iam.disableServiceAccountKeyCreation).
GOOGLE_GENAI_USE_VERTEXAI="auto"

# GOOGLE_CLOUD_PROJECT: Google Cloud project ID linked to your $300 Google Cloud Free Trial billing account.
GOOGLE_CLOUD_PROJECT="cs-project-wsjgygls"

# GOOGLE_CLOUD_LOCATION: Vertex AI region for Gemini publisher models (e.g., "us-central1" or "global").
GOOGLE_CLOUD_LOCATION="us-central1"
